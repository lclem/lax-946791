    @inproceedings{IbarraLeininger:STOC:1980,
    	Abstract = {We look at several classes of straight-line programs and show that the equivalence problem is either undecidable or computationally intractable for all but the trivial classes. For example, there is no algorithm to determine if an arbitrary program (with positive, negative, or zero integer inputs) using only constructs x ← 1, x ← x + y, x ← x/y (integer division) outputs 0 for all inputs. The result holds even if we consider only programs which compute total 0/1 - functions. For programs using constructs x ← 0, x ← c, x ← cx, x ← x/c, x ← x + y, x ← x − y, skip l, if p(x) then skip l, and halt,1 the equivalence problem is decidable in [equation] time ({$\lambda$} is a fixed positive constant and N is the maximum of the sizes of the programs). The bound cannot be reduced to a polynomial in N unless P = NP. In fact, we prove the following rather surprising result: The equivalence problem for programs with one input/output variable and one intermediate variable using only constructs x ← x + y and x ← x/2 is NP-hard. We also show the decidability of the equivalence problem for a certain class of programs and use this result to prove the following: Let IN be the set of natural numbers and f be any total one-to-one function from IN onto IN \texttimes{} IN. (f is called a pair generator. Such functions are useful in recursive function and computability theory.) Then f cannot be computed by any program using only constructs x ← 0, x ← c, x ← x + y, x ← x − y, x ← x * y, x ← x/y, skip l, if p(x) then skip l, and halt.},
    	Address = {New York, NY, USA},
    	Author = {Ibarra, Oscar H. and Leininger, Brian S.},
    	BookTitle = {STOC'80},
    	File = {Equivalence of straight-line programs - 800141.804675.pdf},
    	ISBN = {0897910176},
    	Location = {Los Angeles, California, USA},
    	Pages = {273---280},
    	Publisher = {Association for Computing Machinery},
    	Title = {The Complexity of the Equivalence Problem for Straight-Line Programs},
    	URL = {https://doi.org/10.1145/800141.804675},
    	Year = {1980},
    	bdsk-url-1 = {https://doi.org/10.1145/800141.804675},
    	date-added = {2023-08-26 10:25:24 +0200},
    	date-modified = {2023-08-26 10:25:48 +0200},
    	numpages = {8},
    	doi = {10.1145/800141.804675}
    }
