    @article{Kostolanyi:TCS:2024,
        title = {Finitely Ambiguous and Finitely Sequential Weighted Automata over Fields},
        journal = {Theoretical Computer Science},
        pages = {114725},
        year = {2024},
        issn = {0304-3975},
        doi = {https://doi.org/10.1016/j.tcs.2024.114725},
        url = {https://www.sciencedirect.com/science/article/pii/S0304397524003426},
        author = {Peter Kostolányi},
        keywords = {Weighted automaton, Degree of ambiguity, Degree of sequentiality, Field, Hierarchy},
        abstract = {Expressive power of finitely ambiguous and finitely sequential weighted automata over fields is examined. Rational series realised by such automata can be classified into infinite hierarchies according to ambiguity and sequentiality degrees of realising automata – it is shown that both these hierarchies are strict already over unary alphabets in case the field under consideration is not locally finite. Moreover, the expressive power of finitely sequential, finitely ambiguous, and polynomially ambiguous weighted automata is compared over different fields, both for unary and arbitrary finite alphabets, drawing a complete picture of the relations between corresponding classes of formal power series.},
        date-added = {2024-7-15 6:6:38 +0100}
    }
