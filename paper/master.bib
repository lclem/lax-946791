    @article{LINGG2024106427,
    	Abstract = {One of the most fundamental problems in computational learning theory is the problem of learning a finite automaton A consistent with a finite set P of positive examples and with a finite set N of negative examples. By consistency, we mean that A accepts all strings in P and rejects all strings in N. It is well known that this problem is NP-complete. In the literature, it is stated that NP-hardness holds even in the case of a binary alphabet. As a standard reference for this theorem, the work of Gold from 1978 is either cited or adapted. Nevertheless, the results in Gold's work are stated in terms of Mealy machines, and not in terms of deterministic finite automata (DFAs) as most commonly defined. As Mealy machines are equipped with an output function, they can be more compact than DFAs which accept the same language. We show that the adaptations of Gold's construction for Mealy machines stated in the literature have some issues, and provide a correct proof for the fact that the DFA-consistency problem for binary alphabets is NP-complete.},
    	Author = {Lingg, Jonas and {de Oliveira Oliveira}, Mateus and Wolf, Petra},
    	File = {Learning from positive and negative examples- New proof for binary alphabets - 1-s2.0-S0020019023000704-main - a.pdf},
    	ISSN = {0020-0190},
    	Journal = {Information Processing Letters},
    	Keywords = {Learning automata, Computational complexity, Finite samples},
    	Pages = {106427},
    	Title = {Learning from positive and negative examples: New proof for binary alphabets},
    	URL = {https://www.sciencedirect.com/science/article/pii/S0020019023000704},
    	Volume = {183},
    	Year = {2024},
    	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0020019023000704},
    	bdsk-url-2 = {https://doi.org/10.1016/j.ipl.2023.106427},
    	date-added = {2023-10-04 20:55:18 +0200},
    	date-modified = {2023-10-04 20:55:18 +0200},
    	doi = {10.1016/j.ipl.2023.106427}
    }
