    @Article{         AfshaniFreksenKammaLarsen:2019,
      Author        = "Afshani, Peyman and Freksen, Casper Benjamin and Kamma, Lior and Larsen, Kasper Green",
      Abstract      = {Multiplication is one of the most fundamental computational problems, yet its true complexity remains elusive. The best known upper bound, by F{\"u}rer, shows that two n n -bit numbers can be multiplied via a boolean circuit of size O ( n lg n ⋅ 4 lg ∗ n ) O(n {\l}g n \cdot 4^{{\l}g^*n}) , where lg ∗ n {\l}g^*n is the very slowly growing iterated logarithm. In this work, we prove that if a central conjecture in the area of network coding is true, then any constant degree boolean circuit for multiplication must have size Ω ( n lg n ) \Omega(n {\l}g n) , thus almost completely settling the complexity of multiplication circuits. We additionally revisit classic conjectures in circuit complexity, due to Valiant, and show that the network coding conjecture also implies one of Valiant's conjectures.},
      date-added    = "2019-04-13 07:58:33 +0200",
      date-modified = "2019-04-13 07:58:33 +0200",
      EPrint        = "1902.10935",
      Month         = "02",
