    @article{10.1006/inco.2000.3023,
    	Abstract = {The parallel complexity of computing context-free grammar generating series is investigated. It is known that this problem is in DIV, but in terms of n rather than n, where n is the index of the desired coefficient and is the grammar size. A new method is presented which is in DIV in terms of 22O( ) n. Evidence is provided that any direct application of elimination theory to this problem leads to a space and time resource factor that is nearly exponential in grammar size.},
