    @inproceedings{10.1007/3-540-10843-2_24,
    	Abstract = {Let E be the set of all simple arithmetic expressions of the form E(x)=xT1...Tk, where x is a nonnegative integer variable and each Ti is a multiplication or integer division by a positive integer constant. We investigate the complexity of the inequivalence and the bounded inequivalence problems for expressions in E. (The bounded inequivalence problem is the problem of deciding for arbitrary expressions E1(x) and E2(x) and a positive integer x < ℓ whether or not E1(x)≠E2(x) for some non-negative integer x<ℓ. If ℓ=∞, i.e., there is no upper bound on x, the problem becomes the inequivalence problem.) We show that the inequivalence problem (or equivalently, the equivalence problem) for a large subclass of E is decidable in polynomial time. Whether or not the problem is decidable in polynomial time for the full class E remains open. We also show that the bounded inequivalence problem is NP-complete even if the divisors are restricted to be equal to 2. This last result can be used to sharpen some known NP-completeness results in the literature. Note that if division is rational division, all problems are trivially decidable in polynomial time.},
    	Address = {Berlin, Heidelberg},
    	Author = {Ibarra, Oscar H. and Leininger, Brian S. and Moran, Shlomo},
    	BookTitle = {Automata, Languages and Programming},
    	Editor = {Even, Shimon and Kariv, Oded},
    	File = {On the complexity of simple arithmetic expressions - 3-540-10843-2\_24.pdf},
    	ISBN = {978-3-540-38745-9},
    	Pages = {294--304},
    	Publisher = {Springer Berlin Heidelberg},
    	Title = {On the complexity of simple arithmetic expressions},
    	Year = {1981},
