    @Article{         KarmarkarChakrabortya,
      Author        = "Karmarkar, Hrishikesh and Chakraborty, Supratik",
      Abstract      = "We describe a uniform construction for converting $\omega$-automata with arbitrary acceptance conditions (based on the notion of infinity sets i.e. the set of states visited infinitely often in a run of the automaton) to equivalent deterministic parity automata (DPW). Given a non-deterministic automaton with $n$ states, our construction gives a DPW with at most $2^{O(n^2 \log n)}$ states and $O(n^2)$ parity indices. The corresponding bounds when the original automaton is deterministic are O(n!) and O(n), respectively. Our algorithm gives better asymptotic bounds on the number of states and parity indices vis-a-vis the best known technique when determinizing Rabin or Streett automata with $\Omega{(2^n)}$ acceptance pairs, where $n > 1$. We demonstrate this by describing a family of Streett (and Rabin) automata with $2^{n}$ non-redundant acceptance pairs, for which the best known determinization technique gives a DPW with at least $\Omega{(2^{(n^3)})}$ states, while our construction constructs a DRW/DPW with $2^{O(n^2\log n)}$ states. An easy corollary of our construction is that an $\omega$-language with Rabin index $k$ cannot be recognized by any $\omega$-automaton (deterministic or non-deterministic) with fewer than $O(\sqrt{k})$ states.",
      date-added    = "2012-05-04 09:16:19 +0200",
      date-modified = "2012-05-04 07:16:37 +0000",
      EPrint        = "1101.1841v2",
      Keywords      = "complementation of Buechi automata",
      Month         = "01",
      Title         = "Determinization of {$\omega$}-automata unified",
      URL           = "http://arxiv.org/abs/1101.1841v2",
      Year          = "2011",
      bdsk-url-1    = "http://arxiv.org/abs/1101.1841v2",
      File          = "Determinization of ${$\omega$}$-automata unified - Karmarkar, Chakraborty (0) (0) - a - a - a.pdf"
    }
