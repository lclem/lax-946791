    @article{Muller-Quade:Steinwandt:JSC:1999,
    	Abstract = {By means of Gr{\"o}bner basis techniques algorithms for solving various problems concerning subfields K(g):=K(g1, {\ldots},gm) of a rational function field K(x):=K(x1, {\ldots},xn) are derived: computing canonical generating sets, deciding field membership, computing the degree and separability degree resp. the transcendence degree and a transcendence basis of K(x)/K(g), deciding whetherf∈K(x) is algebraic or transcendental over K(g), computing minimal polynomials, and deciding whether K(g) contains elements of a ``particular structure'', e.g. monic univariate polynomials of fixed degree. The essential idea is to reduce these problems to questions concerning an ideal of a polynomial ring; connections between minimal primary decompositions over K(x) of this ideal and intermediate fields of K(g) and K(x) are given. In the last section some practical considerations concerning the use of the algorithms are discussed.},
    	Author = {M{\"u}ller-Quade, J. and Steinwandt, R.},
