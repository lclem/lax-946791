    @article{10.1145/1459010.1459017,
    	Abstract = {In this article we give a logical characterization of the counting hierarchy. The counting hierarchy is the analogue of the polynomial hierarchy, the building block being Probabilistic polynomial time PP instead of NP. We show that the extension of first-order logic by second-order majority quantifiers of all arities describes exactly the problems in the counting hierarchy. We also consider extending the characterization to general proportional quantifiers Qkr interpreted as ``more than an r-fraction of k-ary relations''. We show that the result holds for rational numbers of the form s/2m but for any other 0 \&lt; r \&lt; 1 the corresponding logic satisfies the 0-1 law.},
    	Address = {New York, NY, USA},
    	Author = {Kontinen, Juha},
    	File = {A logical characterization of the counting hierarchy - 1459010.1459017.pdf},
    	ISSN = {1529-3785},
    	Journal = {ACM Trans. Comput. Logic},
    	Keywords = {the 0-1 law, Counting hierarchy, quantifier elimination, majority quantifiers},
    	Month = {jan},
    	Number = {1},
    	Publisher = {Association for Computing Machinery},
    	Title = {A Logical Characterization of the Counting Hierarchy},
    	URL = {https://doi.org/10.1145/1459010.1459017},
    	Volume = {10},
    	Year = {2009},
