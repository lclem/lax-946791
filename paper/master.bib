      Title         = "Bisimilarity of Probabilistic Pushdown Automata",
      URL           = "http://arxiv.org/abs/1210.2273",
      Year          = "2012",
      bdsk-url-1    = "http://arxiv.org/abs/1210.2273",
      File          = "Bisimilarity of Probabilistic Pushdown Automata - Forejt, Jancar, Kiefer, Worrell (0) (1) - a - a - i.pdf"
    }
