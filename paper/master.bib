    	Title = {Division Algebras},
    	Year = {2003},
    	date-added = {2020-10-25 12:33:44 +0100},
    	date-modified = {2020-10-25 15:17:06 +0100},
    	doi = {10.1007/978-94-017-0337-6_10}
    }
