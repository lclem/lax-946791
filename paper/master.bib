    @article{Amitsur:1978wc,
    	Abstract = {LetD be a division ring with a centerC, andD{$[$}X1, {{\l}dots},XN{$]$} the ring of polynomials inN commutative indeterminates overD. The maximum numberN for which this ring of polynomials is primitive is equal to the maximal transcendence degree overC of the commutative subfields of the matrix ringsMn(D),n=1, 2, {{\l}dots}. The ring of fractions of the Weyl algebras are examples where this numberN is finite. A tool in the proof is a non-commutative version of one of the forms of the ``Nullstellensatz'', namely, simpleD{$[$}X1, {{\l}dots},Xm{$]$}-modules are finite-dimensionalD-spaces.},
