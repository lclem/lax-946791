    @article{Grez:2022aa,
    	Abstract = {We study a variant of the classical membership problem in automata theory, which consists of deciding whether a given input word is accepted by a given automaton. We do so through the lenses of parameterized dynamic data structures: we assume that the automaton is fixed and its size is the parameter, while the input word is revealed as in a stream, one symbol at a time following the natural order on positions. The goal is to design a dynamic data structure that can be efficiently updated upon revealing the next symbol, while maintaining the answer to the query on whether the word consisting of symbols revealed so far is accepted by the automaton. We provide complexity bounds for this dynamic acceptance problem for timed automata that process symbols interleaved with time spans. The main contribution is a dynamic data structure that maintains acceptance of a fixed one-clock timed automaton {\$}{\$}{\{}{$\backslash$}mathcal {\{}A{\}}{\}}{\$}{\$}with amortized update time {\$}{\$}2\^{}{\{}{\{}{$\backslash$}mathcal {\{}O{\}}{\}}({$|$}{\{}{$\backslash$}mathcal {\{}A{\}}{\}}{$|$}){\}}{\$}{\$}per input symbol.},
    	Author = {Grez, Alejandro and Mazowiecki, Filip and Pilipczuk, Micha{\l} and Puppis, Gabriele and Riveros, Cristian},
    	Date = {2022/11/01},
    	File = {Dynamic Data Structures for Timed Automata Acceptance - s00453-022-01025-8 - a.pdf},
    	ISBN = {1432-0541},
    	Journal = {Algorithmica},
    	Number = {11},
    	Pages = {3223--3245},
    	Title = {Dynamic Data Structures for Timed Automata Acceptance},
    	URL = {https://doi.org/10.1007/s00453-022-01025-8},
    	Volume = {84},
    	Year = {2022},
    	bdsk-url-1 = {https://doi.org/10.1007/s00453-022-01025-8},
