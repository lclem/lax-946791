    	file-2 = {Continuously-Analyzing-Finite-Message-Driven-Time-Synchronous-Component-and-Connector-Systems-During-Architecture-Evolution (0) - a - a - e.pdf},
    	doi = {10.1016/j.jss.2018.12.016}
    }
