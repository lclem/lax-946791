    @article{LEISS1981323,
    	Abstract = {Boolean automata are a generalization of finite automata in the sense that the `next state', i.e. the result of the transition function given a state and a letter, is not just a single state (deterministic automata) or a union of states (nondeterministic automata) but a boolean function of states. Boolean automata accept precisely regular languages; furthermore they correspond in a natural way to certain language equations as well as to sequential networks. We investigate the succinctness of representing regular languages by boolean automata. In particular, we show that for every deterministic automaton A with m states there exists a boolean automaton with [log2 m] states which accepts the reverse of the language accepted by A (m≥1). We also show that for every n≥1 there exists a boolean automation with n states such that the smallest deterministic automaton accepting the same language has 2(2n) states; moreover this holds for an alphabet with only two letters.},
    	Author = {Leiss, Ernst},
    	File = {Succinct representation of regular languages by Boolean automata - 1-s2.0-S0304397581800059-main.pdf},
    	ISSN = {0304-3975},
    	Journal = {Theoretical Computer Science},
    	Number = {3},
    	Pages = {323-330},
    	Title = {Succinct representation of regular languages by boolean automata},
