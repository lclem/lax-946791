    	bdsk-url-2 = {http://dx.doi.org/10.1016/j.vaccine.2006.05.115},
    	date-added = {2017-02-14 08:02:25 +0000},
    	date-modified = {2017-02-14 08:02:42 +0000},
    	doi = {10.1016/j.vaccine.2006.05.115}
