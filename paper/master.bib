    @article{DATTA201236,
    	Abstract = {The class NC1 of problems solvable by bounded fan-in circuit families of logarithmic depth is known to be contained in logarithmic space L, but not much about the converse is known. In this paper we examine the structure of classes in between NC1 and L based on counting functions or, equivalently, based on arithmetic circuits. The classes PNC1 and C=NC1, defined by a test for positivity and a test for zero, respectively, of arithmetic circuit families of logarithmic depth, sit in this complexity interval. We study the landscape of Boolean hierarchies, constant-depth oracle hierarchies, and logarithmic-depth oracle hierarchies over PNC1 and C=NC1. We provide complete problems, obtain the upper bound L for all these hierarchies, and prove partial hierarchy collapses. In particular, the constant-depth oracle hierarchy over PNC1 collapses to its first level PNC1, and the constant-depth oracle hierarchy over C=NC1 collapses to its second level.},
    	Author = {Datta, Samir and Mahajan, Meena and {Raghavendra Rao}, B.V. and Thomas, Michael and Vollmer, Heribert},
    	File = {Counting Classes and the Fine Structure between NC1 and L - 1-s2.0-S0304397511004737-main.pdf},
    	ISSN = {0304-3975},
    	Journal = {Theoretical Computer Science},
    	Keywords = {Arithmetic circuits, Complexity classes, , Oracle hierarchy, Threshold classes, Exact counting classes},
    	Note = {Mathematical Foundations of Computer Science (MFCS 2010)},
    	Pages = {36--49},
    	Title = {Counting classes and the fine structure between NC1 and L},
    	URL = {https://www.sciencedirect.com/science/article/pii/S0304397511004737},
    	Volume = {417},
    	Year = {2012},
    	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0304397511004737},
    	bdsk-url-2 = {https://doi.org/10.1016/j.tcs.2011.05.050},
    	date-added = {2022-07-15 14:37:23 +0200},
    	date-modified = {2022-07-16 08:39:39 +0200},
    	doi = {10.1016/j.tcs.2011.05.050}
    }
