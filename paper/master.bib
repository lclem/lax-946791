    @Article{         PouzetSauer,
      Author        = "Pouzet, Maurice and Sauer, Norbert",
      Abstract      = "We consider conditions which force a well-quasi-ordered poset (wqo) to be better-quasi-ordered (bqo). In particular we obtain that if a poset $P$ is wqo and the set $S\_{\omega}(P)$ of strictly increasing sequences of elements of $P$ is bqo under domination, then $P$ is bqo. As a consequence, we get the same conclusion if $S\_{\omega} (P)$ is replaced by $\mathcal J^1(P)$, the collection of non-principal ideals of $P$, or by $AM(P)$, the collection of maximal antichains of $P$ ordered by domination. It then follows that an interval order which is wqo is in fact bqo.",
      date-added    = "2012-12-01 09:58:55 +0000",
      date-modified = "2012-12-01 15:12:15 +0000",
      EPrint        = "math/0601119",
