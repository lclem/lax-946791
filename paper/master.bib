    @conference{f3d4bc92eb7a442b8d6ea874cde742e0,
        title = {ABSTRACT REGULATION OF NONLINEAR SYSTEMS: STABILIZATION, PART II},
        abstract = {This paper constitutes the second part of a previous paper by the author. This paper continues the study of the following problem: given a system S, find necessary and sufficient conditions for the existence of a regulator which stabilizes S (using only available state measurements). When S is defined by analytic differential equations, these conditions assume a particularly simple form. For bilinear (and hence also for linear) systems, they reduce to stabilizability and detectability. An example shows that, for more general systems, stabilizability and detectability are not sufficient.},
        author = {Sontag, {Eduardo D.}},
        year = {1982},
        language = {English (US)},
        pages = {431--435},
        date-added = {2024-2-26 17:7:19 +0100}
    }
