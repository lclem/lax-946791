      Year          = "2012",
      bdsk-url-1    = "http://arxiv.org/abs/1205.4458v1",
      File          = "Model Checking Vector Addition Systems with one zero-test - Bonet, Finkel, Leroux, Zeitoun (0) (0) - a - a - i.pdf"
    }
