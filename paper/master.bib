    @article{10.1145/3462673,
    	Abstract = {We study the language inclusion problem L1 ⊆ L2, where L1 is regular or context-free. Our approach relies on abstract interpretation and checks whether an overapproximating abstraction of L1, obtained by approximating the Kleene iterates of its least fixpoint characterization, is included in L2. We show that a language inclusion problem is decidable whenever this overapproximating abstraction satisfies a completeness condition (i.e., its loss of precision causes no false alarm) and prevents infinite ascending chains (i.e., it guarantees termination of least fixpoint computations). This overapproximating abstraction of languages can be defined using quasiorder relations on words, where the abstraction gives the language of all the words ``greater than or equal to'' a given input word for that quasiorder. We put forward a range of such quasiorders that allow us to systematically design decision procedures for different language inclusion problems, such as regular languages into regular languages or into trace sets of one-counter nets, and context-free languages into regular languages. In the case of inclusion between regular languages, some of the induced inclusion checking procedures correspond to well-known state-of-the-art algorithms, like the so-called antichain algorithms. Finally, we provide an equivalent language inclusion checking algorithm based on a greatest fixpoint computation that relies on quotients of languages and, to the best of our knowledge, was not previously known.},
    	Address = {New York, NY, USA},
    	Author = {Ganty, Pierre and Ranzato, Francesco and Valero, Pedro},
    	File = {Complete Abstractions for Checking Language Inclusion - tocl21.pdf},
    	ISSN = {1529-3785},
    	Journal = {ACM Trans. Comput. Logic},
    	Keywords = {Abstract interpretation, regular language, context-free language, completeness, language inclusion, one-counter net, automaton, grammar},
    	Month = {September},
    	Number = {4},
    	Publisher = {Association for Computing Machinery},
    	Title = {Complete Abstractions for Checking Language Inclusion},
    	URL = {https://doi.org/10.1145/3462673},
    	Volume = {22},
    	Year = {2021},
