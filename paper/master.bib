    @article{FijalkowOhlmannOuakninePoulyWorrell:ToCS:2019,
    	Abstract = {The Orbit Problem consists of determining, given a matrix A on ℚd{\$}{$\backslash$}mathbb {\{}Q{\}}\^{}{\{}d{\}}{\$}, together with vectors x and y, whether the orbit of x under repeated applications of A can ever reach y. This problem was famously shown to be decidable by Kannan and Lipton in the 1980s. In this paper, we are concerned with the problem of synthesising suitable invariantsP⊆ℝd{\$}{$\backslash$}mathcal {\{}P{\}} {$\backslash$}subseteq {$\backslash$}mathbb {\{}R{\}}\^{}{\{}d{\}}{\$}, i.e., sets that are stable under A and contain x but not y, thereby providing compact and versatile certificates of non-reachability. We show that whether a given instance of the Orbit Problem admits a semialgebraic invariant is decidable, and moreover in positive instances we provide an algorithm to synthesise suitable succinct invariants of polynomial size. Our results imply that the class of closed semialgebraic invariants is closure-complete: there exists a closed semialgebraic invariant if and only if y is not in the topological closure of the orbit of x under A.},
    	Author = {Fijalkow, Nathana{\"e}l and Ohlmann, Pierre and Ouaknine, Jo{\"e}l and Pouly, Amaury and Worrell, James},
    	File = {Complete Semialgebraic Invariant Synthesis for the Kannan-Lipton Orbit Problem - Fijalkow2019\_Article\_CompleteSemialgebraicInvariant - a - b.pdf},
    	ISBN = {1433-0490},
    	Journal = {Theory of Computing Systems},
    	Number = {5},
    	Pages = {1027--1048},
    	Title = {Complete Semialgebraic Invariant Synthesis for the Kannan-Lipton Orbit Problem},
    	URL = {https://doi.org/10.1007/s00224-019-09913-3},
    	Volume = {63},
    	Year = {2019},
    	bdsk-url-1 = {https://doi.org/10.1007/s00224-019-09913-3},
    	da = {2019/07/01},
    	date-added = {2020-10-16 16:58:45 +0200},
    	date-modified = {2020-10-16 16:58:45 +0200},
