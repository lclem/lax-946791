    @TechReport{      colcombet:hal-00712771,
      Author        = "Colcombet, Thomas and Daviaud, Laure",
      Abstract      = "{Distance automata are automata weighted over the semiring the tropical semiring. Such automata compute functions from words to N such as the number of occurrences of a given letter. It is known that testing f < g is an undecidable problem for f,g computed by distance automata. The main contribution of this paper is to show that an approximation of this problem becomes decidable. We present an algorithm which, given epsilon>0 and two functions f,g computed by distance automata, answers ''yes'' if f < (1-epsilon)g, ''no'' if there is a word w such that f(w)>g(w), and may answer ''yes'' or ''no'' in all other cases. This result highly refines previously known decidability results of the same type. The core argument behind this quasi-decision procedure is an algorithm which is able to provide an approximated finite presentation to the closure under product of set of matrices over the tropical semiring.}",
      affiliation   = "Laboratoire d'informatique Algorithmique : Fondements et Applications - LIAFA",
      date-added    = "2012-12-18 11:29:35 +0000",
      date-modified = "2012-12-18 11:29:49 +0000",
      hal_id        = "hal-00712771",
      Keywords      = "weighted automata and readme",
      Language      = "Anglais",
      PDF           = "http://hal.archives-ouvertes.fr/hal-00712771/PDF/daviaud\\_colcombet\\_automate\\_distance.pdf",
      Title         = "{Approximate comparison of distance automata}",
      URL           = "http://hal.archives-ouvertes.fr/hal-00712771",
      Year          = "2012",
      bdsk-url-1    = "http://hal.archives-ouvertes.fr/hal-00712771",
      File          = "Approximate comparison of distance automata - Colcombet, Daviaud (0) (1) - a - a - i.pdf"
    }
